<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <VintageStoryInstall Condition="'$(VINTAGE_STORY)' == ''">$(AppData)\Vintagestory</VintageStoryInstall>
    <VintageStoryInstall Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintageStoryInstall>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PepperMod.csproj" />
    <Reference Include="VintagestoryAPI"><HintPath>$(VintageStoryInstall)/VintagestoryAPI.dll</HintPath></Reference>
    <Reference Include="VintagestoryLib"><HintPath>$(VintageStoryInstall)/VintagestoryLib.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(VintageStoryInstall)/Lib/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="protobuf-net"><HintPath>$(VintageStoryInstall)/Lib/protobuf-net.dll</HintPath></Reference>
    <Reference Include="VSSurvivalMod"><HintPath>$(VintageStoryInstall)/Mods/VSSurvivalMod.dll</HintPath></Reference>
    <Reference Include="VSEssentials"><HintPath>$(VintageStoryInstall)/Mods/VSEssentials.dll</HintPath></Reference>
    <Reference Include="cairo-sharp"><HintPath>$(VintageStoryInstall)/Lib/cairo-sharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
